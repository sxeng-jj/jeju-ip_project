# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=
# (선택) AI 가이드가 쓸 모델. 비워 두면 claude-opus-5-5
AI_GUIDE_MODEL=

# (선택) data.go.kr 에서 서비스마다 다른 키를 받았다면 아래에 따로 넣으세요.
# 비워 두면 위의 DATA_GO_KR_KEY 하나로 모두 호출합니다 (같은 계정이면 보통 키가 하나입니다).
CULTURE_INFO_KEY=
CULTURE_FESTIVAL_KEY=
